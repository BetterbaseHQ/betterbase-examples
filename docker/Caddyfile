# Static serving for the unified examples image.
# TLS, rate limiting, and public exposure are handled by the deployment's
# edge proxy (see betterbase-deploy) — this only serves inside the network.

:8080 {
	root * /srv

	# Compress on the wire — the SDK's WASM blobs dominate cold-load bytes
	# (~4.5 MB raw → ~1.3 MB zstd). The edge proxy passes encoded responses
	# through untouched.
	encode zstd gzip

	# Hashed assets are immutable — per-app Vite assets and the shared SDK
	# wasm blobs served at /sdk/* (identical bytes across apps; one download
	# caches for all of them).
	@immutable path */assets/* /sdk/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
}
