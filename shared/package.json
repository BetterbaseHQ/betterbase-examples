{
  "name": "@betterbase/examples-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utilities for Betterbase example apps",
  "license": "Apache-2.0",
  "author": "Betterbase <hello@betterbase.dev>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test": {
      "import": "./src/test/index.ts",
      "types": "./src/test/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external @mantine/core --external @mantine/hooks --external @mantine/notifications --external betterbase --external lucide-react",
    "dev": "tsup src/index.ts --format esm --dts --external react --external @mantine/core --external @mantine/hooks --external @mantine/notifications --external betterbase --external lucide-react --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --write . && pnpm build && pnpm typecheck",
    "test": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "betterbase": "*",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "betterbase": "link:../../betterbase/js",
    "lucide-react": "^0.469.0",
    "playwright": "1.58.2",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@12.4.2"
}